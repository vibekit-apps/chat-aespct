{
  "appId": "com.lunaai.app",
  "appName": "Luna AI",
  "webDir": "www",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#090817",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "small",
      "spinnerStyle": "small",
      "spinnerColor": "#aa91ff"
    }
  },
  "web": {
    "port": 3000
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null,
      "keyAlias": null,
      "keyPassword": null,
      "releaseType": "APK",
      "proguardFile": null,
      "signingProperties": null,
      "signingPropertiesDebug": null
    }
  },
  "ios": {
    "contentInset": "always",
    "scheme": "app",
    "hostname": "localhost"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "https://chat-aespct.vibekit.bot"
    ],
    "cleartext": false
  }
}